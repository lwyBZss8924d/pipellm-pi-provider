{
  "name": "pipellm-pi-provider",
  "version": "0.3.6",
  "private": true,
  "description": "PipeLLM provider for Pi with gateway configuration, Keychain login, and CLI management.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "pack": "bun scripts/build.ts --pack",
    "cli": "bun src/cli.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "test:live": "PIPELLM_LIVE=1 bun test tests/live.test.ts",
    "test:e2e": "PIPELLM_LIVE=1 PIPELLM_E2E=1 bun test tests/e2e.test.ts",
    "format": "prettier --write src scripts tests package.json tsconfig.json distribution/*.md AGENTS.md README.md SECURITY.md SKILL.md SPEC.md",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json distribution/*.md AGENTS.md README.md SECURITY.md SKILL.md SPEC.md"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pipellm"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@openai/codex": "0.160.0",
    "@openai/codex-security": "0.1.31",
    "@types/bun": "1.3.14",
    "incur": "0.7.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwyBZss8924d/pipellm-pi-provider.git"
  },
  "homepage": "https://github.com/lwyBZss8924d/pipellm-pi-provider#readme",
  "bugs": {
    "url": "https://github.com/lwyBZss8924d/pipellm-pi-provider/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
